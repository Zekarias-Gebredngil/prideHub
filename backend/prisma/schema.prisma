// PrideHub - PostgreSQL 18 Schema
// Event Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EVENT_PLANNER
  VENDOR
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING_VERIFICATION
}

enum BookingStatus {
  PENDING
  CONSULTATION
  QUOTATION
  CONFIRMED
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CHAPA
  TELEBIRR
  STRIPE
  BANK_TRANSFER
  CASH
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  GRADUATION
  ENGAGEMENT
  BABY_SHOWER
  TRADITIONAL_WEDDING
  CONCERT
  CONFERENCE
  OTHER
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
  WHATSAPP
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
  PHONE_VERIFICATION
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id                String      @id @default(uuid()) @db.Uuid
  email             String      @unique @db.VarChar(255)
  phone             String?     @unique @db.VarChar(20)
  password          String?     @db.VarChar(255)
  firstName         String      @db.VarChar(100)
  lastName          String      @db.VarChar(100)
  fullName          String      @default("") @db.VarChar(255)
  avatar            String?     @db.VarChar(500)
  role              UserRole    @default(CLIENT)
  status            UserStatus  @default(PENDING_VERIFICATION)
  isEmailVerified   Boolean     @default(false)
  isPhoneVerified   Boolean     @default(false)
  isTwoFactorEnabled Boolean    @default(false)
  twoFactorSecret   String?     @db.VarChar(255)
  googleId          String?     @unique @db.VarChar(255)
  facebookId        String?     @unique @db.VarChar(255)
  microsoftId       String?     @unique @db.VarChar(255)
  lastLoginAt       DateTime?
  lastLoginIp       String?     @db.VarChar(50)
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  profile           ClientProfile?
  vendorProfile     VendorProfile?
  bookings          Booking[]
  reviews           Review[]
  messages          Message[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  otps              Otp[]
  sessions          Session[]
  activityLogs      ActivityLog[]
  auditLogs         AuditLog[]
  assignedBookings  Booking[]   @relation("AssignedPlanner")
  tasks             Task[]      @relation("AssignedTo")
  createdTasks      Task[]      @relation("CreatedBy")
  files             File[]
  blogPosts         BlogPost[]
  contacts          Contact[]
  supportTickets    SupportTicket[]
  crmNotes          CrmNote[]
  followUps         FollowUp[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model ClientProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  company      String?  @db.VarChar(255)
  address      String?  @db.Text
  city         String?  @db.VarChar(100)
  country      String?  @default("Ethiopia") @db.VarChar(100)
  bio          String?  @db.Text
  preferences  Json?
  totalSpent   Decimal  @default(0) @db.Decimal(12, 2)
  totalBookings Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@map("client_profiles")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique @db.VarChar(500)
  userAgent  String?  @db.VarChar(500)
  ipAddress  String?  @db.VarChar(50)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Otp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  code      String   @db.VarChar(10)
  type      OtpType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([phone, type])
  @@map("otps")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique @db.VarChar(500)
  userAgent  String?  @db.VarChar(500)
  ipAddress  String?  @db.VarChar(50)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Vendors ──────────────────────────────────────────────────────────────────

model VendorCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  icon        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendors     VendorProfile[]

  @@map("vendor_categories")
}

model VendorProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  categoryId      String    @db.Uuid
  businessName    String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(280)
  description     String?   @db.Text
  bio             String?   @db.Text
  logo            String?   @db.VarChar(500)
  coverImage      String?   @db.VarChar(500)
  address         String?   @db.Text
  city            String?   @db.VarChar(100)
  website         String?   @db.VarChar(500)
  instagram       String?   @db.VarChar(255)
  facebook        String?   @db.VarChar(255)
  tiktok          String?   @db.VarChar(255)
  basePrice       Decimal?  @db.Decimal(12, 2)
  priceUnit       String?   @db.VarChar(50)
  isVerified      Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  isAvailable     Boolean   @default(true)
  averageRating   Decimal   @default(0) @db.Decimal(3, 2)
  totalReviews    Int       @default(0)
  totalBookings   Int       @default(0)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? 

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        VendorCategory  @relation(fields: [categoryId], references: [id])
  availability    VendorAvailability[]
  reviews         Review[]
  bookingItems    BookingItem[]
  media           Media[]

  @@index([categoryId])
  @@index([isVerified, isFeatured])
  @@index([averageRating])
  @@map("vendor_profiles")
}

model VendorAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  vendorId   String   @db.Uuid
  date       DateTime @db.Date
  isBooked   Boolean  @default(false)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@index([vendorId, date])
  @@map("vendor_availability")
}

// ─── Services ─────────────────────────────────────────────────────────────────

model ServiceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.Text
  icon        String?   @db.VarChar(255)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services    Service[]

  @@map("service_categories")
}

model Service {
  id            String    @id @default(uuid()) @db.Uuid
  categoryId    String    @db.Uuid
  name          String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(280)
  description   String?   @db.Text
  shortDesc     String?   @db.VarChar(500)
  price         Decimal?  @db.Decimal(12, 2)
  priceUnit     String?   @db.VarChar(50)
  duration      String?   @db.VarChar(100)
  coverImage    String?   @db.VarChar(500)
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  seoTitle      String?   @db.VarChar(255)
  seoDesc       String?   @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category      ServiceCategory @relation(fields: [categoryId], references: [id])
  media         Media[]
  bookingItems  BookingItem[]

  @@index([categoryId])
  @@index([isFeatured, isActive])
  @@map("services")
}

// ─── Packages ─────────────────────────────────────────────────────────────────

model Package {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(280)
  tier          String    @db.VarChar(50)
  description   String?   @db.Text
  shortDesc     String?   @db.VarChar(500)
  price         Decimal   @db.Decimal(12, 2)
  discountPct   Decimal   @default(0) @db.Decimal(5, 2)
  coverImage    String?   @db.VarChar(500)
  color         String?   @db.VarChar(20)
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  maxGuests     Int?
  duration      String?   @db.VarChar(100)
  sortOrder     Int       @default(0)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  items         PackageItem[]
  addOns        PackageAddOn[]
  bookings      Booking[]
  media         Media[]

  @@index([isFeatured, isActive])
  @@map("packages")
}

model PackageItem {
  id          String  @id @default(uuid()) @db.Uuid
  packageId   String  @db.Uuid
  description String  @db.VarChar(500)
  isIncluded  Boolean @default(true)
  sortOrder   Int     @default(0)

  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_items")
}

model PackageAddOn {
  id        String  @id @default(uuid()) @db.Uuid
  packageId String  @db.Uuid
  name      String  @db.VarChar(255)
  price     Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_addons")
}

// ─── Venues ───────────────────────────────────────────────────────────────────

model Venue {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(280)
  description   String?   @db.Text
  shortDesc     String?   @db.VarChar(500)
  address       String?   @db.Text
  city          String?   @db.VarChar(100)
  country       String    @default("Ethiopia") @db.VarChar(100)
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  googleMapsUrl String?   @db.VarChar(500)
  capacity      Int?
  minCapacity   Int?
  pricePerDay   Decimal?  @db.Decimal(12, 2)
  amenities     Json?
  coverImage    String?   @db.VarChar(500)
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  averageRating Decimal   @default(0) @db.Decimal(3, 2)
  totalReviews  Int       @default(0)
  seoTitle      String?   @db.VarChar(255)
  seoDesc       String?   @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  availability  VenueAvailability[]
  reviews       Review[]
  bookings      Booking[]
  media         Media[]

  @@index([isFeatured, isActive])
  @@index([city])
  @@map("venues")
}

model VenueAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  venueId    String   @db.Uuid
  date       DateTime @db.Date
  isBooked   Boolean  @default(false)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, date])
  @@index([venueId, date])
  @@map("venue_availability")
}

// ─── Bookings & Events ────────────────────────────────────────────────────────

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  bookingNumber    String        @unique @db.VarChar(20)
  clientId         String        @db.Uuid
  assignedTo       String?       @db.Uuid
  packageId        String?       @db.Uuid
  venueId          String?       @db.Uuid
  eventType        EventType
  eventDate        DateTime
  guestCount       Int?
  budgetMin        Decimal?      @db.Decimal(12, 2)
  budgetMax        Decimal?      @db.Decimal(12, 2)
  totalAmount      Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(12, 2)
  status           BookingStatus @default(PENDING)
  specialRequests  String?       @db.Text
  internalNotes    String?       @db.Text
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  client           User          @relation(fields: [clientId], references: [id])
  planner          User?         @relation("AssignedPlanner", fields: [assignedTo], references: [id])
  package          Package?      @relation(fields: [packageId], references: [id])
  venue            Venue?        @relation(fields: [venueId], references: [id])
  items            BookingItem[]
  event            Event?
  invoices         Invoice[]
  payments         Payment[]
  files            File[]
  tasks            Task[]
  contracts        Contract[]
  timeline         TimelineEntry[]
  messages         Message[]

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
  @@index([assignedTo])
  @@map("bookings")
}

model BookingItem {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @db.Uuid
  serviceId   String?  @db.Uuid
  vendorId    String?  @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service     Service?      @relation(fields: [serviceId], references: [id])
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id])

  @@index([bookingId])
  @@map("booking_items")
}

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String    @unique @db.Uuid
  name          String    @db.VarChar(255)
  description   String?   @db.Text
  startDate     DateTime
  endDate       DateTime?
  progress      Int       @default(0)
  budgetTotal   Decimal   @default(0) @db.Decimal(12, 2)
  budgetSpent   Decimal   @default(0) @db.Decimal(12, 2)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tasks         Task[]
  timeline      TimelineEntry[]

  @@map("events")
}

model Task {
  id           String    @id @default(uuid()) @db.Uuid
  bookingId    String?   @db.Uuid
  eventId      String?   @db.Uuid
  createdById  String    @db.Uuid
  assignedToId String?   @db.Uuid
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  dueDate      DateTime?
  priority     String    @default("MEDIUM") @db.VarChar(20)
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@index([bookingId])
  @@index([assignedToId])
  @@map("tasks")
}

model TimelineEntry {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String?  @db.Uuid
  eventId     String?  @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  date        DateTime
  isDone      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("timeline_entries")
}

// ─── Payments & Invoices ──────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @db.Uuid
  invoiceNumber String        @unique @db.VarChar(20)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  discountAmt   Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?       @db.Text
  pdfUrl        String?       @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([bookingId])
  @@map("invoices")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  invoiceId       String?       @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("ETB") @db.VarChar(10)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionRef  String?       @unique @db.VarChar(255)
  providerRef     String?       @db.VarChar(255)
  paidAt          DateTime?
  notes           String?       @db.Text
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking         Booking       @relation(fields: [bookingId], references: [id])
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  refunds         Refund[]

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id          String        @id @default(uuid()) @db.Uuid
  paymentId   String        @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  reason      String?       @db.Text
  status      PaymentStatus @default(PENDING)
  processedAt DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payment     Payment       @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model Contract {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @db.Uuid
  title       String   @db.VarChar(255)
  content     String   @db.Text
  signedAt    DateTime?
  pdfUrl      String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

// ─── Media & Files ────────────────────────────────────────────────────────────

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  title       String?   @db.VarChar(255)
  url         String    @db.VarChar(500)
  thumbUrl    String?   @db.VarChar(500)
  type        MediaType @default(IMAGE)
  mimeType    String?   @db.VarChar(100)
  size        Int?
  width       Int?
  height      Int?
  duration    Int?
  altText     String?   @db.VarChar(255)
  serviceId   String?   @db.Uuid
  vendorId    String?   @db.Uuid
  venueId     String?   @db.Uuid
  packageId   String?   @db.Uuid
  galleryId   String?   @db.Uuid
  blogPostId  String?   @db.Uuid
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  service     Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  venue       Venue?         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  package     Package?       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  gallery     GalleryAlbum?  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  blogPost    BlogPost?      @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([type])
  @@map("media")
}

model File {
  id          String   @id @default(uuid()) @db.Uuid
  uploadedById String  @db.Uuid
  bookingId   String?  @db.Uuid
  name        String   @db.VarChar(255)
  url         String   @db.VarChar(500)
  type        MediaType @default(DOCUMENT)
  mimeType    String?  @db.VarChar(100)
  size        Int?
  folder      String?  @db.VarChar(255)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@index([bookingId])
  @@map("files")
}

// ─── Gallery ──────────────────────────────────────────────────────────────────

model GalleryAlbum {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(280)
  description String?  @db.Text
  coverImage  String?  @db.VarChar(500)
  category    String?  @db.VarChar(100)
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media       Media[]

  @@map("gallery_albums")
}

// ─── Reviews & Testimonials ───────────────────────────────────────────────────

model Review {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  venueId     String?   @db.Uuid
  vendorId    String?   @db.Uuid
  rating      Int       @db.SmallInt
  comment     String?   @db.Text
  isApproved  Boolean   @default(false)
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User          @relation(fields: [userId], references: [id])
  venue       Venue?        @relation(fields: [venueId], references: [id])
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id])

  @@index([venueId])
  @@index([vendorId])
  @@map("reviews")
}

model Testimonial {
  id          String    @id @default(uuid()) @db.Uuid
  clientName  String    @db.VarChar(255)
  clientTitle String?   @db.VarChar(255)
  avatar      String?   @db.VarChar(500)
  rating      Int       @db.SmallInt
  content     String    @db.Text
  eventType   String?   @db.VarChar(100)
  isApproved  Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  approvedAt  DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isApproved, isFeatured])
  @@map("testimonials")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blogPosts   BlogPost[]

  @@map("categories")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  createdAt DateTime   @default(now())

  blogPosts BlogPostTag[]

  @@map("tags")
}

model BlogPost {
  id            String      @id @default(uuid()) @db.Uuid
  authorId      String      @db.Uuid
  categoryId    String?     @db.Uuid
  title         String      @db.VarChar(500)
  slug          String      @unique @db.VarChar(550)
  excerpt       String?     @db.VarChar(1000)
  content       String      @db.Text
  coverImage    String?     @db.VarChar(500)
  status        BlogStatus  @default(DRAFT)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  readTime      Int?
  views         Int         @default(0)
  seoTitle      String?     @db.VarChar(255)
  seoDesc       String?     @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  author        User        @relation(fields: [authorId], references: [id])
  category      Category?   @relation(fields: [categoryId], references: [id])
  tags          BlogPostTag[]
  comments      BlogComment[]
  media         Media[]

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogPostTag {
  postId    String  @db.Uuid
  tagId     String  @db.Uuid

  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model BlogComment {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String    @db.Uuid
  parentId    String?   @db.Uuid
  authorName  String    @db.VarChar(255)
  authorEmail String    @db.VarChar(255)
  content     String    @db.Text
  isApproved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  post        BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      BlogComment? @relation("Replies", fields: [parentId], references: [id])
  replies     BlogComment[] @relation("Replies")

  @@index([postId])
  @@map("blog_comments")
}

// ─── Notifications & Messaging ────────────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(255)
  body        String           @db.Text
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Message {
  id          String    @id @default(uuid()) @db.Uuid
  bookingId   String?   @db.Uuid
  senderId    String    @db.Uuid
  receiverId  String    @db.Uuid
  content     String    @db.Text
  attachments Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  booking     Booking?  @relation(fields: [bookingId], references: [id])
  sender      User      @relation(fields: [senderId], references: [id])

  @@index([bookingId])
  @@index([senderId, receiverId])
  @@map("messages")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Lead {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String?   @db.Uuid
  name          String    @db.VarChar(255)
  email         String    @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  source        String?   @db.VarChar(100)
  status        String    @default("NEW") @db.VarChar(50)
  interest      String?   @db.VarChar(255)
  budget        Decimal?  @db.Decimal(12, 2)
  notes         String?   @db.Text
  convertedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        ClientProfile? @relation(fields: [clientId], references: [id])
  followUps     FollowUp[]

  @@index([status])
  @@map("leads")
}

model CrmNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  note      String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crm_notes")
}

model FollowUp {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @db.Uuid
  userId      String   @db.Uuid
  scheduledAt DateTime
  notes       String?  @db.Text
  isDone      Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([scheduledAt])
  @@map("follow_ups")
}

// ─── System ───────────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  action      String   @db.VarChar(255)
  entity      String   @db.VarChar(100)
  entityId    String?  @db.VarChar(255)
  description String?  @db.Text
  ipAddress   String?  @db.VarChar(50)
  userAgent   String?  @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entityId   String?  @db.VarChar(255)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(50)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(255)
  value       Json
  group       String?  @db.VarChar(100)
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}

model Newsletter {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(255)
  name        String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

model Faq {
  id          String   @id @default(uuid()) @db.Uuid
  question    String   @db.VarChar(500)
  answer      String   @db.Text
  category    String?  @db.VarChar(100)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @db.Uuid
  name        String    @db.VarChar(255)
  email       String    @db.VarChar(255)
  phone       String?   @db.VarChar(20)
  subject     String    @db.VarChar(500)
  message     String    @db.Text
  isRead      Boolean   @default(false)
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id])

  @@map("contacts")
}

model SupportTicket {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  subject     String        @db.VarChar(500)
  description String        @db.Text
  status      TicketStatus  @default(OPEN)
  priority    String        @default("MEDIUM") @db.VarChar(20)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("support_tickets")
}
