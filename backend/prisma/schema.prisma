// PrideHub - PostgreSQL 18 Schema
// Event Management Platform

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EVENT_PLANNER
  VENDOR
  CLIENT
}

enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
  TIERED
  HYBRID
}

enum CommissionStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
  EXPIRED
}

enum LedgerEntryType {
  BOOKING_CREATED
  DEPOSIT_PAID
  INSTALLMENT_PAID
  COMMISSION_CALCULATED
  COMMISSION_REVERSED
  REFUND_ISSUED
  VENDOR_PAID
  SERVICE_FEE_COLLECTED
  SERVICE_FEE_REVERSED
  SUBSCRIPTION_PURCHASED
  CHARGEBACK
  PENALTY
  ADJUSTMENT
  ESCROW_HELD
  ESCROW_RELEASED
  WITHDRAWAL_PROCESSED
  PLATFORM_REVENUE
}

enum LedgerAccountType {
  CLIENT
  VENDOR
  PLATFORM
  ESCROW
  SUBSCRIPTION
  ADVERTISING
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  WITHDRAWAL
  ADJUSTMENT
  REFUND
}

enum SubscriptionTier {
  FREE
  SILVER
  GOLD
  PLATINUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
  CANCELLED
  GRACE_PERIOD
  EXPIRED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CLIENT
  RESOLVED_VENDOR
  ESCALATED
  CLOSED
}

enum FraudAlertStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum RefundType {
  FULL
  PARTIAL
  CHARGEBACK
  DISPUTE_RESOLUTION
  MANUAL_ADJUSTMENT
}

enum SettlementFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  MANUAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING_VERIFICATION
}

enum BookingStatus {
  PENDING
  CONSULTATION
  QUOTATION
  CONFIRMED
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CHAPA
  TELEBIRR
  STRIPE
  BANK_TRANSFER
  CASH
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  GRADUATION
  ENGAGEMENT
  BABY_SHOWER
  TRADITIONAL_WEDDING
  CONCERT
  CONFERENCE
  OTHER
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
  WHATSAPP
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
  PHONE_VERIFICATION
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id                String      @id @default(uuid()) @db.Uuid
  email             String      @unique @db.VarChar(255)
  phone             String?     @unique @db.VarChar(20)
  password          String?     @db.VarChar(255)
  firstName         String      @db.VarChar(100)
  lastName          String      @db.VarChar(100)
  fullName          String      @default("") @db.VarChar(255)
  avatar            String?     @db.VarChar(500)
  role              UserRole    @default(CLIENT)
  status            UserStatus  @default(PENDING_VERIFICATION)
  isEmailVerified   Boolean     @default(false)
  isPhoneVerified   Boolean     @default(false)
  isTwoFactorEnabled Boolean    @default(false)
  twoFactorSecret   String?     @db.VarChar(255)
  twoFactorBackupCodes String[] @default([])
  googleId          String?     @unique @db.VarChar(255)
  facebookId        String?     @unique @db.VarChar(255)
  microsoftId       String?     @unique @db.VarChar(255)
  lastLoginAt       DateTime?
  lastLoginIp       String?     @db.VarChar(50)
  // Security fields
  failedLoginCount  Int         @default(0)
  lockedUntil       DateTime?
  tokenVersion      Int         @default(0)
  passwordChangedAt DateTime?
  passwordHistory   String[]    @default([])
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  profile           ClientProfile?
  vendorProfile     VendorProfile?
  bookings          Booking[]
  reviews           Review[]
  messages          Message[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  otps              Otp[]
  sessions          Session[]
  activityLogs      ActivityLog[]
  auditLogs         AuditLog[]
  assignedBookings  Booking[]   @relation("AssignedPlanner")
  tasks             Task[]      @relation("AssignedTo")
  createdTasks      Task[]      @relation("CreatedBy")
  files             File[]
  blogPosts         BlogPost[]
  contacts          Contact[]
  supportTickets    SupportTicket[]
  crmNotes          CrmNote[]
  followUps         FollowUp[]
  vendorSubscription VendorSubscription?
  securityEvents    SecurityEvent[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model ClientProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  company      String?  @db.VarChar(255)
  address      String?  @db.Text
  city         String?  @db.VarChar(100)
  country      String?  @default("Ethiopia") @db.VarChar(100)
  bio          String?  @db.Text
  preferences  Json?
  totalSpent   Decimal  @default(0) @db.Decimal(12, 2)
  totalBookings Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@map("client_profiles")
}

model RefreshToken {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  tokenHash    String   @unique @db.VarChar(255)
  family       String   @db.VarChar(64)  // For refresh token rotation family tracking
  userAgent    String?  @db.VarChar(500)
  ipAddress    String?  @db.VarChar(50)
  deviceName   String?  @db.VarChar(255)
  browser      String?  @db.VarChar(100)
  os           String?  @db.VarChar(100)
  country      String?  @db.VarChar(100)
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?  @db.VarChar(100)
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@map("refresh_tokens")
}

model Otp {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  email        String?  @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  codeHash     String   @db.VarChar(255)  // Hashed OTP, never stored plaintext
  type         OtpType
  attempts     Int      @default(0)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([phone, type])
  @@map("otps")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  tokenHash    String   @unique @db.VarChar(255)
  userAgent    String?  @db.VarChar(500)
  ipAddress    String?  @db.VarChar(50)
  deviceName   String?  @db.VarChar(255)
  browser      String?  @db.VarChar(100)
  os           String?  @db.VarChar(100)
  country      String?  @db.VarChar(100)
  expiresAt    DateTime
  lastActivityAt DateTime?
  lastRefreshAt  DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model SecurityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  eventType   String   @db.VarChar(100)
  ipAddress   String?  @db.VarChar(50)
  userAgent   String?  @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@map("security_events")
}

// ─── Vendors ──────────────────────────────────────────────────────────────────

model VendorCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  icon        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendors     VendorProfile[]
  commissionRules CommissionRule[]

  @@map("vendor_categories")
}

model VendorProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  categoryId      String    @db.Uuid
  businessName    String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(280)
  description     String?   @db.Text
  bio             String?   @db.Text
  logo            String?   @db.VarChar(500)
  coverImage      String?   @db.VarChar(500)
  address         String?   @db.Text
  city            String?   @db.VarChar(100)
  website         String?   @db.VarChar(500)
  instagram       String?   @db.VarChar(255)
  facebook        String?   @db.VarChar(255)
  tiktok          String?   @db.VarChar(255)
  basePrice       Decimal?  @db.Decimal(12, 2)
  priceUnit       String?   @db.VarChar(50)
  isVerified      Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  isAvailable     Boolean   @default(true)
  averageRating   Decimal   @default(0) @db.Decimal(3, 2)
  totalReviews    Int       @default(0)
  totalBookings   Int       @default(0)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? 

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        VendorCategory  @relation(fields: [categoryId], references: [id])
  availability    VendorAvailability[]
  reviews         Review[]
  bookingItems    BookingItem[]
  media           Media[]
  wallet          VendorWallet?
  commissionOverride CommissionRule? @relation("VendorCommissionOverride")
  services        Service[]

  @@index([categoryId])
  @@index([isVerified, isFeatured])
  @@index([averageRating])
  @@map("vendor_profiles")
}

model VendorAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  vendorId   String   @db.Uuid
  date       DateTime @db.Date
  isBooked   Boolean  @default(false)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@index([vendorId, date])
  @@map("vendor_availability")
}

// ─── Services ─────────────────────────────────────────────────────────────────

model ServiceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.Text
  icon        String?   @db.VarChar(255)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services    Service[]

  @@map("service_categories")
}

model Service {
  id            String    @id @default(uuid()) @db.Uuid
  categoryId    String    @db.Uuid
  vendorId      String?   @db.Uuid
  name          String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(280)
  description   String?   @db.Text
  shortDesc     String?   @db.VarChar(500)
  price         Decimal?  @db.Decimal(12, 2)
  priceUnit     String?   @db.VarChar(50)
  duration      String?   @db.VarChar(100)
  coverImage    String?   @db.VarChar(500)
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  seoTitle      String?   @db.VarChar(255)
  seoDesc       String?   @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category      ServiceCategory @relation(fields: [categoryId], references: [id])
  vendor        VendorProfile?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  media         Media[]
  bookingItems  BookingItem[]

  @@index([categoryId])
  @@index([isFeatured, isActive])
  @@map("services")
}

// ─── Packages ─────────────────────────────────────────────────────────────────

model Package {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(280)
  tier          String    @db.VarChar(50)
  description   String?   @db.Text
  shortDesc     String?   @db.VarChar(500)
  price         Decimal   @db.Decimal(12, 2)
  discountPct   Decimal   @default(0) @db.Decimal(5, 2)
  coverImage    String?   @db.VarChar(500)
  color         String?   @db.VarChar(20)
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  maxGuests     Int?
  duration      String?   @db.VarChar(100)
  sortOrder     Int       @default(0)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  items         PackageItem[]
  addOns        PackageAddOn[]
  bookings      Booking[]
  media         Media[]

  @@index([isFeatured, isActive])
  @@map("packages")
}

model PackageItem {
  id          String  @id @default(uuid()) @db.Uuid
  packageId   String  @db.Uuid
  description String  @db.VarChar(500)
  isIncluded  Boolean @default(true)
  sortOrder   Int     @default(0)

  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_items")
}

model PackageAddOn {
  id        String  @id @default(uuid()) @db.Uuid
  packageId String  @db.Uuid
  name      String  @db.VarChar(255)
  price     Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_addons")
}

// ─── Venues ───────────────────────────────────────────────────────────────────

model Venue {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(280)
  description   String?   @db.Text
  shortDesc     String?   @db.VarChar(500)
  address       String?   @db.Text
  city          String?   @db.VarChar(100)
  country       String    @default("Ethiopia") @db.VarChar(100)
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  googleMapsUrl String?   @db.VarChar(500)
  capacity      Int?
  minCapacity   Int?
  pricePerDay   Decimal?  @db.Decimal(12, 2)
  amenities     Json?
  coverImage    String?   @db.VarChar(500)
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  averageRating Decimal   @default(0) @db.Decimal(3, 2)
  totalReviews  Int       @default(0)
  seoTitle      String?   @db.VarChar(255)
  seoDesc       String?   @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  availability  VenueAvailability[]
  reviews       Review[]
  bookings      Booking[]
  media         Media[]

  @@index([isFeatured, isActive])
  @@index([city])
  @@map("venues")
}

model VenueAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  venueId    String   @db.Uuid
  date       DateTime @db.Date
  isBooked   Boolean  @default(false)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, date])
  @@index([venueId, date])
  @@map("venue_availability")
}

// ─── Bookings & Events ────────────────────────────────────────────────────────

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  bookingNumber    String        @unique @db.VarChar(20)
  clientId         String        @db.Uuid
  assignedTo       String?       @db.Uuid
  packageId        String?       @db.Uuid
  venueId          String?       @db.Uuid
  eventType        EventType
  eventDate        DateTime
  guestCount       Int?
  budgetMin        Decimal?      @db.Decimal(12, 2)
  budgetMax        Decimal?      @db.Decimal(12, 2)
  totalAmount      Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(12, 2)
  platformFee      Decimal       @default(0) @db.Decimal(12, 2)
  platformFeeRate  Decimal       @default(0) @db.Decimal(5, 4)
  status           BookingStatus @default(PENDING)
  specialRequests  String?       @db.Text
  internalNotes    String?       @db.Text
  completedAt      DateTime?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  client           User          @relation(fields: [clientId], references: [id])
  planner          User?         @relation("AssignedPlanner", fields: [assignedTo], references: [id])
  package          Package?      @relation(fields: [packageId], references: [id])
  venue            Venue?        @relation(fields: [venueId], references: [id])
  items            BookingItem[]
  event            Event?
  invoices         Invoice[]
  payments         Payment[]
  files            File[]
  tasks            Task[]
  contracts        Contract[]
  timeline         TimelineEntry[]
  messages         Message[]
  commissions      CommissionTransaction[]
  escrowAccount    EscrowAccount?
  settlement       VendorSettlement?

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
  @@index([assignedTo])
  @@map("bookings")
}

model BookingItem {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @db.Uuid
  serviceId   String?  @db.Uuid
  vendorId    String?  @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service     Service?      @relation(fields: [serviceId], references: [id])
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id])

  @@index([bookingId])
  @@map("booking_items")
}

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String    @unique @db.Uuid
  name          String    @db.VarChar(255)
  description   String?   @db.Text
  startDate     DateTime
  endDate       DateTime?
  progress      Int       @default(0)
  budgetTotal   Decimal   @default(0) @db.Decimal(12, 2)
  budgetSpent   Decimal   @default(0) @db.Decimal(12, 2)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tasks         Task[]
  timeline      TimelineEntry[]

  @@map("events")
}

model Task {
  id           String    @id @default(uuid()) @db.Uuid
  bookingId    String?   @db.Uuid
  eventId      String?   @db.Uuid
  createdById  String    @db.Uuid
  assignedToId String?   @db.Uuid
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  dueDate      DateTime?
  priority     String    @default("MEDIUM") @db.VarChar(20)
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@index([bookingId])
  @@index([assignedToId])
  @@map("tasks")
}

model TimelineEntry {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String?  @db.Uuid
  eventId     String?  @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  date        DateTime
  isDone      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("timeline_entries")
}

// ─── Payments & Invoices ──────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @db.Uuid
  invoiceNumber String        @unique @db.VarChar(20)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  discountAmt   Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?       @db.Text
  pdfUrl        String?       @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([bookingId])
  @@map("invoices")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  invoiceId       String?       @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("ETB") @db.VarChar(10)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionRef  String?       @unique @db.VarChar(255)
  providerRef     String?       @db.VarChar(255)
  paidAt          DateTime?
  notes           String?       @db.Text
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking         Booking       @relation(fields: [bookingId], references: [id])
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  refunds         Refund[]
  commissions     CommissionTransaction[]

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id          String        @id @default(uuid()) @db.Uuid
  paymentId   String        @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  reason      String?       @db.Text
  status      PaymentStatus @default(PENDING)
  processedAt DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payment     Payment       @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model Contract {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @db.Uuid
  title       String   @db.VarChar(255)
  content     String   @db.Text
  signedAt    DateTime?
  pdfUrl      String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

// ─── Media & Files ────────────────────────────────────────────────────────────

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  title       String?   @db.VarChar(255)
  url         String    @db.VarChar(500)
  thumbUrl    String?   @db.VarChar(500)
  type        MediaType @default(IMAGE)
  mimeType    String?   @db.VarChar(100)
  size        Int?
  width       Int?
  height      Int?
  duration    Int?
  altText     String?   @db.VarChar(255)
  serviceId   String?   @db.Uuid
  vendorId    String?   @db.Uuid
  venueId     String?   @db.Uuid
  packageId   String?   @db.Uuid
  galleryId   String?   @db.Uuid
  blogPostId  String?   @db.Uuid
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  service     Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  venue       Venue?         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  package     Package?       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  gallery     GalleryAlbum?  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  blogPost    BlogPost?      @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([type])
  @@map("media")
}

model File {
  id          String   @id @default(uuid()) @db.Uuid
  uploadedById String  @db.Uuid
  bookingId   String?  @db.Uuid
  name        String   @db.VarChar(255)
  url         String   @db.VarChar(500)
  type        MediaType @default(DOCUMENT)
  mimeType    String?  @db.VarChar(100)
  size        Int?
  folder      String?  @db.VarChar(255)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@index([bookingId])
  @@map("files")
}

// ─── Gallery ──────────────────────────────────────────────────────────────────

model GalleryAlbum {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(280)
  description String?  @db.Text
  coverImage  String?  @db.VarChar(500)
  category    String?  @db.VarChar(100)
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media       Media[]

  @@map("gallery_albums")
}

// ─── Reviews & Testimonials ───────────────────────────────────────────────────

model Review {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  venueId     String?   @db.Uuid
  vendorId    String?   @db.Uuid
  rating      Int       @db.SmallInt
  comment     String?   @db.Text
  isApproved  Boolean   @default(false)
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User          @relation(fields: [userId], references: [id])
  venue       Venue?        @relation(fields: [venueId], references: [id])
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id])

  @@index([venueId])
  @@index([vendorId])
  @@map("reviews")
}

model Testimonial {
  id          String    @id @default(uuid()) @db.Uuid
  clientName  String    @db.VarChar(255)
  clientTitle String?   @db.VarChar(255)
  avatar      String?   @db.VarChar(500)
  rating      Int       @db.SmallInt
  content     String    @db.Text
  eventType   String?   @db.VarChar(100)
  isApproved  Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  approvedAt  DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isApproved, isFeatured])
  @@map("testimonials")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blogPosts   BlogPost[]

  @@map("categories")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  createdAt DateTime   @default(now())

  blogPosts BlogPostTag[]

  @@map("tags")
}

model BlogPost {
  id            String      @id @default(uuid()) @db.Uuid
  authorId      String      @db.Uuid
  categoryId    String?     @db.Uuid
  title         String      @db.VarChar(500)
  slug          String      @unique @db.VarChar(550)
  excerpt       String?     @db.VarChar(1000)
  content       String      @db.Text
  coverImage    String?     @db.VarChar(500)
  status        BlogStatus  @default(DRAFT)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  readTime      Int?
  views         Int         @default(0)
  seoTitle      String?     @db.VarChar(255)
  seoDesc       String?     @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  author        User        @relation(fields: [authorId], references: [id])
  category      Category?   @relation(fields: [categoryId], references: [id])
  tags          BlogPostTag[]
  comments      BlogComment[]
  media         Media[]

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogPostTag {
  postId    String  @db.Uuid
  tagId     String  @db.Uuid

  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model BlogComment {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String    @db.Uuid
  parentId    String?   @db.Uuid
  authorName  String    @db.VarChar(255)
  authorEmail String    @db.VarChar(255)
  content     String    @db.Text
  isApproved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  post        BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      BlogComment? @relation("Replies", fields: [parentId], references: [id])
  replies     BlogComment[] @relation("Replies")

  @@index([postId])
  @@map("blog_comments")
}

// ─── Notifications & Messaging ────────────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(255)
  body        String           @db.Text
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Message {
  id          String    @id @default(uuid()) @db.Uuid
  bookingId   String?   @db.Uuid
  senderId    String    @db.Uuid
  receiverId  String    @db.Uuid
  content     String    @db.Text
  attachments Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  booking     Booking?  @relation(fields: [bookingId], references: [id])
  sender      User      @relation(fields: [senderId], references: [id])

  @@index([bookingId])
  @@index([senderId, receiverId])
  @@map("messages")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Lead {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String?   @db.Uuid
  name          String    @db.VarChar(255)
  email         String    @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  source        String?   @db.VarChar(100)
  status        String    @default("NEW") @db.VarChar(50)
  interest      String?   @db.VarChar(255)
  budget        Decimal?  @db.Decimal(12, 2)
  notes         String?   @db.Text
  convertedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        ClientProfile? @relation(fields: [clientId], references: [id])
  followUps     FollowUp[]

  @@index([status])
  @@map("leads")
}

model CrmNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  note      String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crm_notes")
}

model FollowUp {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @db.Uuid
  userId      String   @db.Uuid
  scheduledAt DateTime
  notes       String?  @db.Text
  isDone      Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([scheduledAt])
  @@map("follow_ups")
}

// ─── System ───────────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  action      String   @db.VarChar(255)
  entity      String   @db.VarChar(100)
  entityId    String?  @db.VarChar(255)
  description String?  @db.Text
  ipAddress   String?  @db.VarChar(50)
  userAgent   String?  @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entityId   String?  @db.VarChar(255)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(50)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(255)
  value       Json
  group       String?  @db.VarChar(100)
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}

model Newsletter {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(255)
  name        String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

model Faq {
  id          String   @id @default(uuid()) @db.Uuid
  question    String   @db.VarChar(500)
  answer      String   @db.Text
  category    String?  @db.VarChar(100)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @db.Uuid
  name        String    @db.VarChar(255)
  email       String    @db.VarChar(255)
  phone       String?   @db.VarChar(20)
  subject     String    @db.VarChar(500)
  message     String    @db.Text
  isRead      Boolean   @default(false)
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id])

  @@map("contacts")
}

model SupportTicket {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  subject     String        @db.VarChar(500)
  description String        @db.Text
  status      TicketStatus  @default(OPEN)
  priority    String        @default("MEDIUM") @db.VarChar(20)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("support_tickets")
}

// ─── Commission Engine ────────────────────────────────────────────────────────

model CommissionSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  globalDefaultRate   Decimal  @default(0.10) @db.Decimal(5, 4)
  platformFeeRate     Decimal  @default(0.03) @db.Decimal(5, 4)
  currency            String   @default("ETB") @db.VarChar(10)
  settlementFrequency SettlementFrequency @default(WEEKLY)
  settlementDayOfWeek Int      @default(1)  // 1=Monday
  settlementDayOfMonth Int     @default(1)
  minWithdrawalAmount Decimal  @default(100) @db.Decimal(12, 2)
  maxWithdrawalAmount Decimal  @default(500000) @db.Decimal(12, 2)
  escrowHoldDays      Int      @default(7)
  isActive            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  updatedById         String?  @db.Uuid

  @@map("commission_settings")
}

model CommissionRule {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(255)
  description     String?          @db.Text
  type            CommissionType   @default(PERCENTAGE)
  status          CommissionStatus @default(ACTIVE)
  priority        Int              @default(0)
  // Scope: null = applies globally
  vendorId        String?          @unique @db.Uuid   // vendor-specific override
  categoryId      String?          @db.Uuid           // vendor category
  subscriptionTier SubscriptionTier?                  // subscription tier
  campaignId      String?          @db.Uuid           // campaign override
  // Rate config
  rate            Decimal?         @db.Decimal(5, 4)  // for PERCENTAGE type
  fixedAmount     Decimal?         @db.Decimal(12, 2) // for FIXED_AMOUNT type
  tiers           Json?            // for TIERED type: [{minAmount, maxAmount, rate}]
  minAmount       Decimal?         @db.Decimal(12, 2)
  maxAmount       Decimal?         @db.Decimal(12, 2)
  region          String?          @db.VarChar(100)
  currency        String           @default("ETB") @db.VarChar(10)
  effectiveFrom   DateTime         @default(now())
  effectiveTo     DateTime?
  isEnabled       Boolean          @default(true)
  approvedById    String?          @db.Uuid
  approvedAt      DateTime?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  vendor          VendorProfile?   @relation("VendorCommissionOverride", fields: [vendorId], references: [id])
  category        VendorCategory?  @relation(fields: [categoryId], references: [id])
  transactions    CommissionTransaction[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status, isEnabled])
  @@index([priority])
  @@map("commission_rules")
}

model CommissionCampaign {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  discountRate  Decimal  @db.Decimal(5, 4)  // Commission reduction
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  maxBookings   Int?
  usedCount     Int      @default(0)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("commission_campaigns")
}

model CommissionTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  bookingId         String   @db.Uuid
  paymentId         String?  @db.Uuid
  vendorId          String   @db.Uuid
  ruleId            String?  @db.Uuid
  grossAmount       Decimal  @db.Decimal(12, 2)  // Full booking amount
  commissionRate    Decimal  @db.Decimal(5, 4)
  commissionAmount  Decimal  @db.Decimal(12, 2)
  platformFeeRate   Decimal  @db.Decimal(5, 4)
  platformFeeAmount Decimal  @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(12, 2)
  vendorNetPayout   Decimal  @db.Decimal(12, 2)
  currency          String   @default("ETB") @db.VarChar(10)
  status            String   @default("PENDING") @db.VarChar(20)
  settledAt         DateTime?
  reversedAt        DateTime?
  reversalReason    String?  @db.Text
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  booking           Booking        @relation(fields: [bookingId], references: [id])
  payment           Payment?       @relation(fields: [paymentId], references: [id])
  rule              CommissionRule? @relation(fields: [ruleId], references: [id])

  @@index([bookingId])
  @@index([vendorId])
  @@index([status])
  @@map("commission_transactions")
}

// ─── Financial Ledger (Immutable) ────────────────────────────────────────────

model FinancialLedger {
  id              String            @id @default(uuid()) @db.Uuid
  entryType       LedgerEntryType
  accountType     LedgerAccountType
  accountId       String            @db.Uuid      // userId or vendorId
  referenceId     String?           @db.Uuid      // bookingId, paymentId, etc.
  referenceType   String?           @db.VarChar(50)
  debitAmount     Decimal           @default(0) @db.Decimal(12, 2)
  creditAmount    Decimal           @default(0) @db.Decimal(12, 2)
  balance         Decimal           @db.Decimal(12, 2)
  currency        String            @default("ETB") @db.VarChar(10)
  description     String?           @db.Text
  reversalOf      String?           @db.Uuid      // If this is a reversal entry
  metadata        Json?
  createdAt       DateTime          @default(now())
  createdById     String?           @db.Uuid

  @@index([accountId, accountType])
  @@index([referenceId, referenceType])
  @@index([entryType])
  @@index([createdAt])
  @@map("financial_ledger")
}

// ─── Escrow ───────────────────────────────────────────────────────────────────

model EscrowAccount {
  id              String       @id @default(uuid()) @db.Uuid
  bookingId       String       @unique @db.Uuid
  vendorId        String       @db.Uuid
  grossAmount     Decimal      @db.Decimal(12, 2)
  commissionAmount Decimal     @db.Decimal(12, 2)
  platformFeeAmount Decimal    @db.Decimal(12, 2)
  vendorNetAmount Decimal      @db.Decimal(12, 2)
  currency        String       @default("ETB") @db.VarChar(10)
  status          EscrowStatus @default(HELD)
  heldAt          DateTime     @default(now())
  releaseAt       DateTime?    // Scheduled release date
  releasedAt      DateTime?
  refundedAt      DateTime?
  disputeId       String?      @db.Uuid
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  booking         Booking      @relation(fields: [bookingId], references: [id])
  transactions    EscrowTransaction[]

  @@index([vendorId, status])
  @@map("escrow_accounts")
}

model EscrowTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  escrowId    String   @db.Uuid
  type        String   @db.VarChar(50)  // HOLD, RELEASE, REFUND, DISPUTE
  amount      Decimal  @db.Decimal(12, 2)
  description String?  @db.Text
  performedById String? @db.Uuid
  createdAt   DateTime @default(now())

  escrow      EscrowAccount @relation(fields: [escrowId], references: [id])

  @@index([escrowId])
  @@map("escrow_transactions")
}

// ─── Vendor Wallet ────────────────────────────────────────────────────────────

model VendorWallet {
  id                 String   @id @default(uuid()) @db.Uuid
  vendorId           String   @unique @db.Uuid
  availableBalance   Decimal  @default(0) @db.Decimal(12, 2)
  pendingBalance     Decimal  @default(0) @db.Decimal(12, 2)
  heldBalance        Decimal  @default(0) @db.Decimal(12, 2)
  lifetimeEarnings   Decimal  @default(0) @db.Decimal(12, 2)
  totalCommissionPaid Decimal @default(0) @db.Decimal(12, 2)
  totalWithdrawn     Decimal  @default(0) @db.Decimal(12, 2)
  totalRefunds       Decimal  @default(0) @db.Decimal(12, 2)
  currency           String   @default("ETB") @db.VarChar(10)
  bankName           String?  @db.VarChar(255)
  bankAccountNumber  String?  @db.VarChar(255)
  bankAccountName    String?  @db.VarChar(255)
  telebirrNumber     String?  @db.VarChar(20)
  chapaAccountRef    String?  @db.VarChar(255)
  isPayoutEnabled    Boolean  @default(true)
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vendor             VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions       WalletTransaction[]
  withdrawals        WithdrawalRequest[]

  @@map("vendor_wallets")
}

model WalletTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  walletId        String                @db.Uuid
  type            WalletTransactionType
  amount          Decimal               @db.Decimal(12, 2)
  balanceBefore   Decimal               @db.Decimal(12, 2)
  balanceAfter    Decimal               @db.Decimal(12, 2)
  currency        String                @default("ETB") @db.VarChar(10)
  description     String?               @db.Text
  referenceId     String?               @db.Uuid
  referenceType   String?               @db.VarChar(50)
  metadata        Json?
  createdAt       DateTime              @default(now())

  wallet          VendorWallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id              String           @id @default(uuid()) @db.Uuid
  walletId        String           @db.Uuid
  vendorId        String           @db.Uuid
  amount          Decimal          @db.Decimal(12, 2)
  currency        String           @default("ETB") @db.VarChar(10)
  method          String           @db.VarChar(50) // BANK, TELEBIRR, CHAPA
  bankName        String?          @db.VarChar(255)
  accountNumber   String?          @db.VarChar(255)
  accountName     String?          @db.VarChar(255)
  status          WithdrawalStatus @default(PENDING)
  requestedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedById    String?          @db.Uuid
  processedAt     DateTime?
  completedAt     DateTime?
  rejectionReason String?          @db.Text
  transactionRef  String?          @db.VarChar(255)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  wallet          VendorWallet @relation(fields: [walletId], references: [id])

  @@index([vendorId, status])
  @@map("withdrawal_requests")
}

// ─── Settlement Engine ────────────────────────────────────────────────────────

model SettlementBatch {
  id               String            @id @default(uuid()) @db.Uuid
  batchNumber      String            @unique @db.VarChar(30)
  frequency        SettlementFrequency
  periodStart      DateTime
  periodEnd        DateTime
  totalGrossAmount Decimal           @default(0) @db.Decimal(12, 2)
  totalCommission  Decimal           @default(0) @db.Decimal(12, 2)
  totalPlatformFee Decimal           @default(0) @db.Decimal(12, 2)
  totalNetPayout   Decimal           @default(0) @db.Decimal(12, 2)
  vendorCount      Int               @default(0)
  bookingCount     Int               @default(0)
  status           SettlementStatus  @default(PENDING)
  processedAt      DateTime?
  completedAt      DateTime?
  failureReason    String?           @db.Text
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?           @db.Uuid

  settlements      VendorSettlement[]

  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("settlement_batches")
}

model VendorSettlement {
  id               String           @id @default(uuid()) @db.Uuid
  settlementNumber String           @unique @db.VarChar(30)
  batchId          String           @db.Uuid
  vendorId         String           @db.Uuid
  bookingId        String?          @unique @db.Uuid
  grossAmount      Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  platformFeeAmount Decimal         @db.Decimal(12, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(12, 2)
  netPayout        Decimal          @db.Decimal(12, 2)
  currency         String           @default("ETB") @db.VarChar(10)
  status           SettlementStatus @default(PENDING)
  paidAt           DateTime?
  paymentRef       String?          @db.VarChar(255)
  invoiceUrl       String?          @db.VarChar(500)
  notes            String?          @db.Text
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  batch            SettlementBatch  @relation(fields: [batchId], references: [id])
  booking          Booking?         @relation(fields: [bookingId], references: [id])

  @@index([vendorId, status])
  @@index([batchId])
  @@map("vendor_settlements")
}

// ─── Platform Revenue ─────────────────────────────────────────────────────────

model PlatformRevenue {
  id              String   @id @default(uuid()) @db.Uuid
  category        String   @db.VarChar(100) // COMMISSION, SUBSCRIPTION, ADVERTISING, PLATFORM_FEE, CANCELLATION_FEE
  sourceId        String?  @db.Uuid
  sourceType      String?  @db.VarChar(50)
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("ETB") @db.VarChar(10)
  description     String?  @db.Text
  recordedAt      DateTime @default(now())
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([recordedAt])
  @@map("platform_revenue")
}

// ─── Subscription Engine ──────────────────────────────────────────────────────

model SubscriptionPlan {
  id                 String           @id @default(uuid()) @db.Uuid
  tier               SubscriptionTier @unique
  name               String           @db.VarChar(100)
  description        String?          @db.Text
  monthlyPrice       Decimal          @db.Decimal(12, 2)
  quarterlyPrice     Decimal          @db.Decimal(12, 2)
  yearlyPrice        Decimal          @db.Decimal(12, 2)
  commissionRate     Decimal          @db.Decimal(5, 4)   // Override commission rate
  features           Json?
  maxListings        Int?
  priorityRanking    Int              @default(0)
  isFeatured         Boolean          @default(false)
  hasAnalytics       Boolean          @default(false)
  hasEarlyPayout     Boolean          @default(false)
  hasDedicatedManager Boolean         @default(false)
  hasApiAccess       Boolean          @default(false)
  trialDays          Int              @default(0)
  isActive           Boolean          @default(true)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  subscriptions      VendorSubscription[]

  @@map("subscription_plans")
}

model VendorSubscription {
  id              String             @id @default(uuid()) @db.Uuid
  vendorId        String             @unique @db.Uuid
  planId          String             @db.Uuid
  status          SubscriptionStatus @default(ACTIVE)
  billingCycle    String             @default("MONTHLY") @db.VarChar(20)
  startDate       DateTime           @default(now())
  endDate         DateTime?
  trialEndsAt     DateTime?
  graceEndsAt     DateTime?
  cancelledAt     DateTime?
  renewedAt       DateTime?
  proratedAmount  Decimal?           @db.Decimal(12, 2)
  currentPeriodStart DateTime        @default(now())
  currentPeriodEnd   DateTime?
  autoRenew       Boolean            @default(true)
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  vendor          User               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments        SubscriptionPayment[]

  @@index([status])
  @@map("vendor_subscriptions")
}

model SubscriptionPayment {
  id              String   @id @default(uuid()) @db.Uuid
  subscriptionId  String   @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("ETB") @db.VarChar(10)
  status          String   @default("PENDING") @db.VarChar(20)
  billingPeriod   String   @db.VarChar(50)
  paidAt          DateTime?
  invoiceUrl      String?  @db.VarChar(500)
  metadata        Json?
  createdAt       DateTime @default(now())

  subscription    VendorSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_payments")
}

// ─── Disputes & Refunds ───────────────────────────────────────────────────────

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  initiatedById   String        @db.Uuid
  againstId       String        @db.Uuid
  type            String        @db.VarChar(50)  // CLIENT_COMPLAINT, VENDOR_DISPUTE, CHARGEBACK
  reason          String        @db.Text
  status          DisputeStatus @default(OPEN)
  resolution      String?       @db.Text
  resolvedById    String?       @db.Uuid
  resolvedAt      DateTime?
  escrowHeld      Boolean       @default(true)
  disputedAmount  Decimal       @db.Decimal(12, 2)
  refundAmount    Decimal?      @db.Decimal(12, 2)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  evidence        DisputeEvidence[]

  @@index([bookingId])
  @@index([status])
  @@map("disputes")
}

model DisputeEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  disputeId   String   @db.Uuid
  submittedById String  @db.Uuid
  type        String   @db.VarChar(50)  // DOCUMENT, IMAGE, TEXT
  content     String   @db.Text
  fileUrl     String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  dispute     Dispute  @relation(fields: [disputeId], references: [id])

  @@map("dispute_evidence")
}

model RefundRequest {
  id              String     @id @default(uuid()) @db.Uuid
  bookingId       String     @db.Uuid
  paymentId       String     @db.Uuid
  requestedById   String     @db.Uuid
  type            RefundType
  amount          Decimal    @db.Decimal(12, 2)
  reason          String     @db.Text
  status          String     @default("PENDING") @db.VarChar(20)
  approvedById    String?    @db.Uuid
  approvedAt      DateTime?
  processedAt     DateTime?
  vendorDeduction Decimal    @default(0) @db.Decimal(12, 2)
  commissionAdj   Decimal    @default(0) @db.Decimal(12, 2)
  platformFeeAdj  Decimal    @default(0) @db.Decimal(12, 2)
  notes           String?    @db.Text
  metadata        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([bookingId])
  @@index([paymentId])
  @@map("refund_requests")
}

// ─── Fraud Detection ──────────────────────────────────────────────────────────

model FraudAlert {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String?         @db.Uuid
  type        String          @db.VarChar(100) // MULTIPLE_ACCOUNTS, FAKE_BOOKING, CHARGEBACK_ABUSE, etc.
  severity    String          @default("MEDIUM") @db.VarChar(20)
  description String          @db.Text
  status      FraudAlertStatus @default(OPEN)
  evidence    Json?
  resolvedById String?        @db.Uuid
  resolvedAt  DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([type, status])
  @@map("fraud_alerts")
}

// ─── Tax Configuration ────────────────────────────────────────────────────────

model TaxConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(50)  // VAT, GST, WITHHOLDING, INCOME_TAX
  rate        Decimal  @db.Decimal(5, 4)
  region      String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  appliesTo   String[] // COMMISSION, PLATFORM_FEE, SUBSCRIPTION, ALL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tax_configurations")
}

